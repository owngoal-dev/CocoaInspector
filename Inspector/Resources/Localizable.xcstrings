    "This asks the process to shut down on its own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب هذا من العملية أن تُغلق نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozess wird gebeten, sich selbst zu beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide al proceso que se cierre por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus est invité à se fermer de lui-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスに自分で終了するよう求めます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процессу будет предложено завершиться самостоятельно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会请求进程自行关闭。"
          }
        }
      }
    },
    "This ends the process immediately. Unsaved work can be lost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي هذا العملية فورًا، وقد تُفقد الأعمال غير المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozess wird sofort beendet. Nicht gesicherte Arbeit kann verloren gehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso terminará de inmediato. El trabajo sin guardar puede perderse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus s’arrête immédiatement. Le travail non enregistré peut être perdu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスをただちに終了します。保存していない作業は失われることがあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процесс завершится немедленно. Несохранённые данные могут быть потеряны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会立即结束进程，未保存的内容可能丢失。"
          }
        }
      }
    },
